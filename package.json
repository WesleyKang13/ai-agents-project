{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "types:check": "tsc --noEmit",
        "format": "prettier --write resources/js resources/css vite.config.js tsconfig.json package.json",
        "format:check": "prettier --check resources/js resources/css vite.config.js tsconfig.json package.json"
    },
    "dependencies": {
        "@inertiajs/react": "^3.11.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0"
    },
    "devDependencies": {
        "@inertiajs/vite": "^3.11.0",
        "@tailwindcss/vite": "^4.0.0",
        "@types/node": "^20.0.0",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@vitejs/plugin-react": "^6.3.0",
        "concurrently": "^9.2.5",
        "laravel-vite-plugin": "^3.1",
        "prettier": "^3.0.0",
        "tailwindcss": "^4.0.0",
        "typescript": "^7.0.2",
        "vite": "^8.0.0"
    },
    "engines": {
        "node": "^20.19.0 || >=22.12.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    }
}
